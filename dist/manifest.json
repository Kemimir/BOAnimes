{
  "name": "CrunchyBoa - By Kemir",
  "version": "1.2.0",
  "description": "Reorganiza a interface da Crunchyroll e rastreia séries com favoritos, assistidos e assistir depois",
  "author": "Kemir",
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_title": "CrunchyBoa",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/Kemimir/CrunchyBoa/main/*",
    "https://graphql.anilist.co/*",
    "*://*.crunchyroll.com/*",
    "*://*.animesorion.com/*",
    "*://*.animesonlinecc.to/*",
    "*://*.animefire.plus/*",
    "*://*.otakuflix.com/*",
    "*://*.animesonehd.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.crunchyroll.com/*"],
      "js": ["content/main.js"],
      "css": ["styles/main.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.animesorion.com/*", "*://*.animesonlinecc.to/*", "*://*.animefire.plus/*", "*://*.otakuflix.com/*", "*://*.animesonehd.com/*"],
      "js": ["content/main.js"],
      "css": ["styles/main.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["styles/main.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "manifest_version": 3
}




