{
  "manifest_version": 3,
  "name": "BOAnimes - By Kemir",
  "version": "2.9.0",
  "description": "Melhora a Crunchyroll e acompanha seus animes: favoritos, episódios vistos, Crunchylistas e AniList",
  "author": "Kemir",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "BOAnimes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/Kemimir/BOAnimes/main/*",
    "https://graphql.anilist.co/*",
    "*://*.crunchyroll.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.crunchyroll.com/*"
      ],
      "js": [
        "content/early.js"
      ],
      "css": [
        "styles/theme.css",
        "styles/crunchyroll.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "content/page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.crunchyroll.com/*"
      ],
      "js": [
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://*.crunchyroll.com/*"
      ]
    }
  ]
}
